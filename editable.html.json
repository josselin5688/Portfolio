ius:0 3px 3px 0;\n  -moz-border-radius:0 3px 3px 0;\n  -webkit-border-radius:0 3px 3px 0;\n}\n\n.skill-bar-percent {\n  position:absolute;\n  right:10px;\n  top:0;\n  font-size:11px;\n  height:40px;\n  line-height:40px;\n  color:#ffffff;\n  color:rgba(0, 0, 0, 0.4);\n}\n</style>\n<script type=\"text/javascript\">\n  var fillBarSize = $('.skillbar').width() * (1 - 25 / 100);\n  var doc = $(document);\n  doc.scroll(function() {\n    var skillbars = $('.skillbar');\n    // Start animation when the skillbars hit the middle of the screen\n    if (skillbars.offset().top <= (doc.scrollTop() + $(window).height()/2)) {\n      $('.skillbar').each(function(){\n        $(this).find('.skillbar-bar').delay(2140).animate({\n          width: (fillBarSize * parseInt($(this).attr('data-percent')) / 100) + 'px'\n        },6000);\n      });\n    }\n  });\n</script>\n"},{"id":"silex-id-1736780525563-0","pageNames":["page-home"],"classList":["text-shadow"],"type":"text-element","isSectionContent":false,"title":"","alt":null,"children":[],"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":true},"selected":false,"useMinHeight":true,"visibility":{"desktop":true,"mobile":true},"style":{"desktop":{"width":"703px","box-sizing":"content-box","height":"203px","position":"static"},"mobile":{}},"data":{"component":null},"innerHtml":"<h1>Étudiant en M2 Médias et Mondialisation à l'Université Panthéon-Assas</h1>","tagName":"DIV"},{"id":"silex-id-1736781944754-2","tagName":"DIV","type":"image-element","alt":null,"title":null,"isSectionContent":false,"visibility":{"desktop":true,"mobile":true},"style":{"mobile":{},"desktop":{"width":"384px","height":"254px","position":"absolute","top":"-172px","left":"-2px"}},"data":{"component":null},"children":[],"pageNames":["page-home"],"classList":[],"attr":{},"link":null,"enableEdit":true,"enableDrag":true,"enableDrop":false,"enableResize":{"top":true,"bottom":true,"left":true,"right":t